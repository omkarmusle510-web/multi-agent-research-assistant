# Multi-Agent Research Assistant Environment Configuration

# LLM Provider: "openai", "groq", "ollama", or "mock" (offline fallback)
LLM_PROVIDER=mock

# OpenAI / OpenAI-Compatible API Key (Optional if LLM_PROVIDER=mock)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Name (e.g., gpt-4o-mini, gpt-4o, llama3-70b-8192)
OPENAI_MODEL=gpt-4o-mini

# Custom Base URL (Optional - for Ollama, Groq, LMStudio, etc.)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Search Provider: "duckduckgo", "tavily", or "mock"
SEARCH_PROVIDER=duckduckgo

# Tavily API Key (Optional, only needed if SEARCH_PROVIDER=tavily)
# TAVILY_API_KEY=your_tavily_api_key_here

# Max search queries generated per research breakdown
MAX_SEARCH_QUERIES=4

# Max search results fetched per query
MAX_RESULTS_PER_QUERY=3

# Output Directory for generated research reports
OUTPUT_DIR=./reports

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
